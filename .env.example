# Database (leave empty locally to use SQLite; set in production)
DATABASE_URL=

# Email (Gmail SMTP). In production set these in the Render dashboard.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=edmilsonfabiovalente@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
